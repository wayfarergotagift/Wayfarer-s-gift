<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>tehreem :: birthday dreamscape</title>
<style>

  :root{
    --void: #050108;
    --deep: #12041f;
    --violet: #7b3fe4;
    --violet2: #a97bff;
    --cyan: #4de3ff;
    --iceblue: #b3ecff;
    --hot: #ff4fd8;
    --white: #f4eaff;
  }

  *{ margin:0; padding:0; box-sizing:border-box; }

  html,body{
    height:100%;
    width:100%;
    background: var(--void);
    overflow-x:hidden;
    font-family: 'Courier New', monospace;
  }

  .stage{
    position:relative;
    width:100vw;
    min-height:100vh;
    perspective: 900px;
    perspective-origin: 50% 40%;
    background:
      radial-gradient(ellipse at 50% 28%, rgba(123,63,228,0.35), transparent 60%),
      radial-gradient(ellipse at 50% 90%, rgba(77,227,255,0.12), transparent 55%),
      linear-gradient(180deg, var(--void) 0%, var(--deep) 100%);
    padding-bottom:120px;
  }

  /* ---------------- overlays ---------------- */
  .scanlines{
    position:fixed; inset:0; z-index:50; pointer-events:none;
    background: repeating-linear-gradient(to bottom,
      rgba(255,255,255,0.035) 0px, rgba(255,255,255,0.035) 1px,
      transparent 2px, transparent 3px);
    mix-blend-mode: overlay;
    animation: scanShift 6s linear infinite;
  }
  @keyframes scanShift{ from{ background-position:0 0; } to{ background-position:0 100px; } }

  .vignette{
    position:fixed; inset:0; z-index:49; pointer-events:none;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.75) 100%);
  }

  .flicker{
    position:fixed; inset:0; z-index:51; pointer-events:none;
    background: rgba(180,120,255,0.02);
    animation: flick 0.18s steps(2) infinite;
  }
  @keyframes flick{ 0%{opacity:0.4;} 50%{opacity:0.9;} 100%{opacity:0.5;} }

  /* ---------------- warped grid floor ---------------- */
  .floor{
    position:absolute;
    bottom:0; left:50%;
    width:200vw; height:60vh;
    transform: translateX(-50%) rotateX(78deg);
    transform-origin: bottom center;
    background-image:
      linear-gradient(rgba(169,123,255,0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(169,123,255,0.5) 1px, transparent 1px);
    background-size: 60px 60px;
    -webkit-mask-image: linear-gradient(to top, black 20%, transparent 90%);
    mask-image: linear-gradient(to top, black 20%, transparent 90%);
    animation: gridMove 3s linear infinite;
    opacity:0.5;
  }
  @keyframes gridMove{ from{ background-position:0 0,0 0; } to{ background-position:0 60px,0 0; } }

  /* ---------------- hero section with the eye ---------------- */
  .hero{
    position:relative;
    height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .orbit{ position:absolute; top:50%; left:50%; width:1px; height:1px; }
  .orbit-ring{ position:absolute; top:0; left:0; animation: spin linear infinite; }
  .orbit-ring .shape{ position:absolute; transform: translate(-50%,-50%); }
  @keyframes spin{ from{ transform: rotate(0deg); } to{ transform: rotate(360deg); } }

  .tri{
    width:0; height:0;
    border-left:8px solid transparent;
    border-right:8px solid transparent;
    border-bottom:14px solid var(--cyan);
    filter: drop-shadow(0 0 8px var(--cyan));
  }
  .diamond{
    width:14px; height:14px;
    background: var(--hot);
    transform: translate(-50%,-50%) rotate(45deg);
    filter: drop-shadow(0 0 8px var(--hot));
  }
  .ring-dot{
    width:10px; height:10px;
    border-radius:50%;
    background: var(--violet2);
    filter: drop-shadow(0 0 8px var(--violet2));
  }
  .star-shape{
    width:12px; height:12px;
    background: var(--white);
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    filter: drop-shadow(0 0 8px var(--white));
  }

  /* ---------------- black hole ---------------- */
  .blackhole-wrap{
    position:relative;
    width:320px; height:320px;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .bh-glow{
    position:absolute;
    width:100%; height:100%;
    border-radius:50%;
    background: radial-gradient(circle, rgba(79,227,255,0.35), transparent 65%);
    filter: blur(10px);
    animation: bhGlowPulse 3s ease-in-out infinite;
  }
  @keyframes bhGlowPulse{
    0%,100%{ opacity:0.6; transform:scale(1); }
    50%{ opacity:1; transform:scale(1.08); }
  }

  .accretion-disk{
    position:absolute;
    width:280px; height:280px;
    border-radius:50%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      var(--iceblue) 30deg,
      var(--cyan) 90deg,
      #023047 150deg,
      transparent 200deg,
      transparent 260deg,
      var(--cyan) 320deg,
      transparent 360deg
    );
    filter: blur(2px);
    animation: diskSpin 6s linear infinite;
    -webkit-mask-image: radial-gradient(circle, transparent 33%, black 40%, black 62%, transparent 68%);
    mask-image: radial-gradient(circle, transparent 33%, black 40%, black 62%, transparent 68%);
  }
  @keyframes diskSpin{ from{ transform: rotate(0deg); } to{ transform: rotate(360deg); } }

  .accretion-disk.thin{
    width:230px; height:230px;
    animation-duration:4s;
    animation-direction:reverse;
    filter: blur(1px);
    opacity:0.85;
    -webkit-mask-image: radial-gradient(circle, transparent 40%, black 46%, black 54%, transparent 60%);
    mask-image: radial-gradient(circle, transparent 40%, black 46%, black 54%, transparent 60%);
  }

  .photon-ring{
    position:absolute;
    width:150px; height:150px;
    border-radius:50%;
    box-shadow:
      0 0 12px 2px rgba(255,255,255,0.95),
      0 0 40px 8px rgba(79,227,255,0.75),
      0 0 80px 20px rgba(2,48,71,0.55);
    animation: ringFlicker 2.4s ease-in-out infinite;
  }
  @keyframes ringFlicker{
    0%,100%{ opacity:0.85; }
    50%{ opacity:1; }
  }

  .event-horizon{
    position:relative;
    width:130px; height:130px;
    border-radius:50%;
    background: radial-gradient(circle at 40% 35%, #041018 0%, #000000 60%);
    box-shadow: inset 0 0 30px 10px rgba(0,0,0,0.9), 0 0 40px rgba(0,0,0,0.9);
    z-index:2;
    overflow:hidden;
  }

  .bh-line{
    position:absolute;
    top:50%; left:50%;
    width:1.5px;
    height:var(--len);
    background: linear-gradient(to top, transparent, var(--cyan), transparent);
    box-shadow: 0 0 6px var(--cyan), 0 0 12px rgba(79,227,255,0.7);
    transform-origin: bottom center;
    transform: translate(-50%,-100%) rotate(var(--angle));
    opacity:0;
    animation-name: lineFlicker;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  @keyframes lineFlicker{
    0%{ opacity:0; }
    45%{ opacity:0; }
    55%{ opacity:0.9; }
    75%{ opacity:0.9; }
    100%{ opacity:0; }
  }

  .bh-dust{
    position:absolute;
    border-radius:50%;
    animation: bhOrbit linear infinite;
  }
  @keyframes bhOrbit{
    from{ transform: rotate(0deg) translateX(150px) rotate(0deg); }
    to{ transform: rotate(360deg) translateX(150px) rotate(-360deg); }
  }

  .title-wrap{ margin-top:70px; text-align:center; }

  .eyebrow{
    letter-spacing:6px;
    text-transform:uppercase;
    font-size:12px;
    color: var(--cyan);
    margin-bottom:16px;
    opacity:0.8;
  }

  .glitch{
    position:relative;
    font-size: clamp(30px, 7vw, 60px);
    font-weight:bold;
    letter-spacing:4px;
    color: var(--white);
    text-transform:uppercase;
    text-shadow: 0 0 18px rgba(169,123,255,0.8);
  }
  .glitch::before, .glitch::after{
    content: attr(data-text);
    position:absolute; top:0; left:0; right:0;
    overflow:hidden;
  }
  .glitch::before{
    color: var(--cyan);
    clip-path: polygon(0 0, 100% 0, 100% 45%, 0 45%);
    animation: glitchTop 3.2s infinite linear alternate-reverse;
  }
  .glitch::after{
    color: var(--hot);
    clip-path: polygon(0 60%, 100% 60%, 100% 100%, 0 100%);
    animation: glitchBottom 2.6s infinite linear alternate-reverse;
  }
  @keyframes glitchTop{
    0%{transform:translate(0,0);} 10%{transform:translate(-4px,-1px);}
    20%{transform:translate(3px,1px);} 30%{transform:translate(-2px,0);}
    40%{transform:translate(0,0);} 100%{transform:translate(0,0);}
  }
  @keyframes glitchBottom{
    0%{transform:translate(0,0);} 15%{transform:translate(4px,1px);}
    25%{transform:translate(-3px,-1px);} 35%{transform:translate(2px,0);}
    45%{transform:translate(0,0);} 100%{transform:translate(0,0);}
  }

  .subtitle{
    margin-top:16px;
    font-size:13px;
    letter-spacing:4px;
    color: rgba(200,170,255,0.7);
    text-transform:uppercase;
  }

  .date-pill{
    display:inline-block;
    margin-top:26px;
    padding:9px 24px;
    border:1px solid rgba(169,123,255,0.6);
    border-radius:999px;
    font-size:13px;
    letter-spacing:3px;
    color: var(--violet2);
    background: rgba(123,63,228,0.08);
    box-shadow: 0 0 20px rgba(123,63,228,0.3);
  }

  .scroll-cue{
    position:absolute;
    bottom:30px; left:50%;
    transform: translateX(-50%);
    font-size:11px;
    letter-spacing:4px;
    color: rgba(200,170,255,0.5);
    text-transform:uppercase;
    animation: bob 2s ease-in-out infinite;
  }
  @keyframes bob{ 0%,100%{ transform: translate(-50%,0); } 50%{ transform: translate(-50%,8px); } }

  /* ---------------- dust ---------------- */
  .dust{
    position:absolute; bottom:0;
    border-radius:50%;
    background: var(--violet2);
    opacity:0.5;
    filter: blur(0.5px);
    animation: drift linear infinite;
  }
  @keyframes drift{
    0%{ transform: translateY(0) translateX(0); opacity:0; }
    10%{ opacity:0.6; } 90%{ opacity:0.6; }
    100%{ transform: translateY(-100vh) translateX(30px); opacity:0; }
  }

  /* ---------------- quote section ---------------- */
  .quote-section{
    position:relative;
    z-index:10;
    max-width:680px;
    margin:0 auto;
    padding:20px 24px 0;
    text-align:center;
  }

  .section-label{
    letter-spacing:5px;
    text-transform:uppercase;
    font-size:12px;
    color: var(--hot);
    margin-bottom:30px;
    opacity:0.85;
  }

  .quote-stage{
    position:relative;
    max-width:640px;
    margin:0 auto;
    min-height:200px;
  }

  .quote-card{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:30px 28px;
    border-radius:18px;
    background: linear-gradient(160deg, rgba(169,123,255,0.08), rgba(0,0,0,0.2));
    border:1px solid rgba(169,123,255,0.3);
    box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 40px rgba(123,63,228,0.15);
    opacity:0;
    animation: quoteCycle 24s infinite;
  }
  .quote-card p{
    font-size:clamp(16px, 2.4vw, 19px);
    line-height:1.6;
    font-style:italic;
    color: var(--white);
  }
  .quote-card span{
    display:block;
    margin-top:14px;
    font-style:normal;
    font-size:11px;
    letter-spacing:3px;
    text-transform:uppercase;
    color: var(--cyan);
  }
  .quote-card:nth-child(1){ animation-delay:0s; }
  .quote-card:nth-child(2){ animation-delay:4s; }
  .quote-card:nth-child(3){ animation-delay:8s; }
  .quote-card:nth-child(4){ animation-delay:12s; }
  .quote-card:nth-child(5){ animation-delay:16s; }
  .quote-card:nth-child(6){ animation-delay:20s; }

  @keyframes quoteCycle{
    0%{ opacity:0; transform: translateY(10px) scale(0.98); }
    3%{ opacity:1; transform: translateY(0) scale(1); }
    14%{ opacity:1; transform: translateY(0) scale(1); }
    17%{ opacity:0; transform: translateY(-10px) scale(0.98); }
    100%{ opacity:0; }
  }

  .dots{ display:flex; justify-content:center; gap:8px; margin-top:220px; }
  .dots span{
    width:6px; height:6px; border-radius:50%;
    background: rgba(169,123,255,0.3);
    animation: dotPulse 24s infinite;
  }
  .dots span:nth-child(1){animation-delay:0s;}
  .dots span:nth-child(2){animation-delay:4s;}
  .dots span:nth-child(3){animation-delay:8s;}
  .dots span:nth-child(4){animation-delay:12s;}
  .dots span:nth-child(5){animation-delay:16s;}
  .dots span:nth-child(6){animation-delay:20s;}
  @keyframes dotPulse{
    0%{background:rgba(169,123,255,0.3); transform:scale(1);}
    5%{background:var(--violet2); transform:scale(1.4);}
    17%{background:var(--violet2); transform:scale(1.4);}
    20%{background:rgba(169,123,255,0.3); transform:scale(1);}
    100%{background:rgba(169,123,255,0.3); transform:scale(1);}
  }

  /* ---------------- wish grid ---------------- */
  .wish-section{
    position:relative;
    z-index:10;
    max-width:640px;
    margin:110px auto 0;
    padding:0 24px;
    text-align:center;
  }

  .cake-icon{
    font-size:52px;
    display:inline-block;
    filter: drop-shadow(0 0 14px rgba(169,123,255,0.7));
    animation: floatIcon 3.5s ease-in-out infinite;
  }
  @keyframes floatIcon{ 0%,100%{ transform: translateY(0); } 50%{ transform: translateY(-10px); } }

  .book-title{
    margin-top:18px;
    margin-bottom:8px;
  }
  .book-title-main{
    font-size: clamp(20px, 3.2vw, 28px);
    letter-spacing:2px;
    color: var(--white);
    text-shadow: 0 0 14px rgba(79,227,255,0.5);
  }
  .book-title-sub{
    margin-top:8px;
    font-size:12px;
    letter-spacing:3px;
    text-transform:uppercase;
    color: rgba(200,170,255,0.55);
  }

  .wish-list{
    list-style:none;
    margin-top:32px;
    display:flex;
    flex-direction:column;
    gap:14px;
    text-align:left;
  }
  .wish-list li{
    background: rgba(169,123,255,0.05);
    border-left:3px solid var(--violet2);
    padding:16px 20px;
    border-radius:8px;
    font-size:15px;
    line-height:1.6;
    color: rgba(244,234,255,0.9);
  }
  .wish-list li b{ color: var(--hot); }

  /* ---------------- booklet ---------------- */
  .booklet{
    position:relative;
    margin-top:36px;
    display:grid;
    grid-template-columns:1fr 1fr;
    background: linear-gradient(160deg, rgba(20,8,35,0.9), rgba(5,2,10,0.95));
    border-radius:10px;
    box-shadow: 0 30px 70px rgba(0,0,0,0.6), 0 0 40px rgba(123,63,228,0.15);
    padding:8px;
    border:1px solid rgba(169,123,255,0.25);
  }

  .booklet::before{
    content:'';
    position:absolute;
    top:8px; bottom:8px; left:50%;
    width:2px;
    transform:translateX(-50%);
    background: linear-gradient(to bottom, transparent, rgba(169,123,255,0.6), transparent);
    box-shadow: 0 0 12px rgba(169,123,255,0.6);
    z-index:2;
  }

  .page{
    position:relative;
    perspective:1200px;
    min-height:190px;
  }

  .page-inner{
    position:relative;
    width:100%;
    height:100%;
    min-height:190px;
    transition: transform 0.8s cubic-bezier(.4,.2,.2,1);
    transform-style: preserve-3d;
    cursor:pointer;
  }

  .page:nth-child(odd) .page-inner{ transform-origin: left center; }
  .page:nth-child(even) .page-inner{ transform-origin: right center; }

  .page:nth-child(odd).flipped .page-inner{ transform: rotateY(-170deg); }
  .page:nth-child(even).flipped .page-inner{ transform: rotateY(170deg); }

  .page-face{
    position:absolute;
    inset:0;
    backface-visibility:hidden;
    -webkit-backface-visibility:hidden;
    padding:22px 20px 30px;
    font-size:14px;
    line-height:1.6;
    color: rgba(244,234,255,0.9);
    display:flex;
    align-items:center;
    background: rgba(169,123,255,0.04);
  }

  .page-face.back{
    transform: rotateY(180deg);
    background: rgba(79,227,255,0.06);
  }

  .page:nth-child(odd) .page-face{
    border-radius:8px 2px 2px 8px;
    box-shadow: inset -8px 0 14px -12px rgba(0,0,0,0.7);
  }
  .page:nth-child(even) .page-face{
    border-radius:2px 8px 8px 2px;
    box-shadow: inset 8px 0 14px -12px rgba(0,0,0,0.7);
  }

  .page b{ color: var(--hot); }

  .page-front-content{
    display:flex;
    flex-direction:column;
    gap:6px;
  }
  .page-front-content .flip-hint{
    font-size:10px;
    letter-spacing:2px;
    text-transform:uppercase;
    color: var(--cyan);
    opacity:0.75;
  }

  .page-icon{
    font-size:22px;
    margin-bottom:2px;
    filter: drop-shadow(0 0 6px rgba(79,227,255,0.5));
  }

  .teaser{
    font-size:12px;
    font-style:italic;
    color: rgba(244,234,255,0.55);
    margin-top:2px;
  }

  .back-content{
    display:flex;
    flex-direction:column;
    gap:10px;
  }
  .back-content p{
    font-size:13.5px;
    line-height:1.65;
  }

  .page-num{
    position:absolute;
    bottom:8px;
    font-size:10px;
    letter-spacing:2px;
    color: rgba(169,123,255,0.5);
  }
  .page:nth-child(odd) .page-num{ right:14px; }
  .page:nth-child(even) .page-num{ left:14px; }

  footer{
    position:relative;
    z-index:10;
    margin-top:80px;
    text-align:center;
    font-size:12px;
    letter-spacing:3px;
    color: rgba(200,170,255,0.4);
    text-transform:uppercase;
    padding-bottom:20px;
  }
  footer .heart{
    color: var(--hot);
    display:inline-block;
    animation: heartbeat 1.4s ease-in-out infinite;
  }
  @keyframes heartbeat{ 0%,100%{ transform:scale(1); } 50%{ transform:scale(1.25); } }

</style>
</head>
<body>

  <div class="stage">

    <div class="floor"></div>

    <div class="hero">

      <div class="orbit">
        <div class="orbit-ring" style="animation-duration:14s;">
          <div class="shape diamond" style="top:-190px; left:0;"></div>
          <div class="shape diamond" style="top:190px; left:0;"></div>
        </div>
        <div class="orbit-ring" style="animation-duration:20s; animation-direction:reverse;">
          <div class="shape tri" style="top:-240px; left:0;"></div>
          <div class="shape tri" style="top:0; left:240px; transform: translate(-50%,-50%) rotate(90deg);"></div>
          <div class="shape tri" style="top:240px; left:0;"></div>
          <div class="shape tri" style="top:0; left:-240px; transform: translate(-50%,-50%) rotate(-90deg);"></div>
        </div>
        <div class="orbit-ring" style="animation-duration:9s;">
          <div class="shape ring-dot" style="top:-150px; left:0;"></div>
          <div class="shape ring-dot" style="top:75px; left:130px;"></div>
          <div class="shape ring-dot" style="top:75px; left:-130px;"></div>
          <div class="shape ring-dot" style="top:150px; left:0;"></div>
        </div>
        <div class="orbit-ring" style="animation-duration:26s; animation-direction:reverse;">
          <div class="shape star-shape" style="top:-280px; left:0;"></div>
          <div class="shape star-shape" style="top:280px; left:0;"></div>
          <div class="shape star-shape" style="top:0; left:280px;"></div>
          <div class="shape star-shape" style="top:0; left:-280px;"></div>
        </div>
      </div>

      <div class="eye-wrap">
        <div class="blackhole-wrap">
          <div class="bh-glow"></div>
          <div class="accretion-disk"></div>
          <div class="accretion-disk thin"></div>
          <div class="photon-ring"></div>
          <div class="bh-dust" style="width:3px;height:3px; background:var(--cyan); animation-duration:5s;"></div>
          <div class="bh-dust" style="width:2px;height:2px; background:var(--iceblue); animation-duration:7s; animation-delay:-2s;"></div>
          <div class="bh-dust" style="width:3px;height:3px; background:#0369a1; animation-duration:6s; animation-delay:-4s;"></div>
          <div class="bh-dust" style="width:2px;height:2px; background:var(--white); animation-duration:8s; animation-delay:-1s;"></div>
          <div class="event-horizon">
            <div class="bh-line" style="--angle:15deg; --len:52px; animation-duration:3.2s; animation-delay:0s;"></div>
            <div class="bh-line" style="--angle:70deg; --len:44px; animation-duration:4.1s; animation-delay:0.6s;"></div>
            <div class="bh-line" style="--angle:130deg; --len:58px; animation-duration:2.8s; animation-delay:1.1s;"></div>
            <div class="bh-line" style="--angle:200deg; --len:40px; animation-duration:3.6s; animation-delay:0.3s;"></div>
            <div class="bh-line" style="--angle:255deg; --len:50px; animation-duration:4.6s; animation-delay:1.6s;"></div>
            <div class="bh-line" style="--angle:310deg; --len:46px; animation-duration:3.1s; animation-delay:2s;"></div>
          </div>
        </div>

        <div class="title-wrap">
          <div class="eyebrow">the universe has noticed</div>
          <div class="glitch" data-text="HAPPY BIRTHDAY TEHREEM">HAPPY BIRTHDAY TEHREEM</div>
          <div class="subtitle">besto friendo · zero logic · fully loved</div>
          <div class="date-pill">🎂 OCTOBER 12</div>
